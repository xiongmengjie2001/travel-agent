# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，本文件仅提交字段名。
# CLAUDE.md 禁止事项：禁止在业务逻辑中硬编码 API Key，必须从环境变量读取。
#
# 本文件由 main.py 顶部的 load_dotenv() 加载（规则见 docs/module-sdd/config.md）。
# 优先级：真实环境变量 > .env > 代码内默认值。改完必须**重启后端**才生效。
# 最省事的用法：cp .env.example .env，只填 DEEPSEEK_API_KEY 一行。

# ---------------------------------------------------------------- DeepSeek
# DEEPSEEK_API_KEY 留空 = 纯模板模式（不出网、不报错，走 AC-5 的降级路径）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# ⚠️ 若服务端不认识这个模型名，调用会失败 —— 而失败是**静默**的：日志里一条
# WARNING，接口照常返回 code 0，只是卡片上一直挂着「降级模板方案」。排查时先看
# 这里。DeepSeek 官方常用名：deepseek-chat / deepseek-reasoner。
# 换成任何 OpenAI 兼容服务只需改本行与 DEEPSEEK_BASE_URL 两处。
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------- 降级
# true = 强制不发起真实 LLM 调用，即使上面配了 Key（对应 NFR-2 / AC-5）。
# 真值写法：1 / true / yes / on（忽略大小写）；其他值一律视为 false，不报错。
USE_MOCK_LLM=false

# ------------------------------------------------------------------- 存储
MEMORY_DB_PATH=./data/travel_agent.db

# --------------------------------------------------------------- 外部数据源
# 高德地图 MCP Server（规格见 docs/module-sdd/mcp.md）。
# AMAP_MCP_URL 是总开关：留空 = 纯 Mock 模式，weather / attractions / route
# 三个工具都不发起网络请求，回落到 src/tools.py 的内置静态数据。
# 默认端点：https://mcp.amap.com/mcp
AMAP_MCP_URL=
# 高德 API Key。若 AMAP_MCP_URL 已自带 ?key=... 则可留空；
# 留空且 URL 不带 key 时，MCP 调用会被高德拒绝并自动降级 Mock（不报错）。
AMAP_MCP_KEY=
# 心知天气 API 私钥（seniverse.com，免费版 3 天预报）。weather 工具的降级
# 顺序：高德 MCP → 心知 → Mock 静态表。留空 = 跳过心知这一级。
SENIVERSE_API_KEY=

# ------------------------------------------------------------------- 服务
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

# ------------------------------------------------------------------- 前端
# VITE_* 变量**不在这里设**：Vite 只读 frontend/ 目录下的 .env*，根目录这份对它
# 无效。前端默认留空走 vite.config.js 的 /api 代理（同源，不涉及 CORS）；确需
# 直连后端时写进 frontend/.env.local（已被 .gitignore 的 *.local 覆盖）。
